# ===== Python 编译缓存（必须忽略，否则很乱） =====
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ===== 虚拟环境（不要上传，太大了） =====
env/
venv/
ENV/
.venv

# ===== 开发工具配置文件（别人不需要你的个人设置） =====
.vscode/
.idea/
*.iml

# ===== Windows 系统垃圾文件 =====
Thumbs.db
Desktop.ini
~$*

# ===== Office 临时文件（Word/Excel 打开时产生的锁文件） =====
~$*.docx
~$*.xlsx
*.tmp

# ===== CAD 自动保存与备份文件 =====
*.bak
*.dwl
*.dwl2
*.sv$

# ===== 重要：环境变量/密钥文件（坚决不上传） =====
.env
*.key
*.pem

# ===== 日志文件 =====
*.log
